APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedding_invites
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# CORS: the frontend origin(s), comma-separated, exact scheme+host+port.
# The first entry is also where /share/{slug} redirects real visitors.
FRONTEND_URLS=http://localhost:5174

# Admin/client login tokens (bearer, stored in the browser) expire after
# this many minutes. Default: 7 days.
SANCTUM_TOKEN_EXPIRATION=10080

# Seeded account passwords. Leave empty in local dev to use the dev defaults;
# in any other environment an empty value means a random password is
# generated and printed once by `db:seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_CLIENT_PASSWORD=

# Existing event dates saved before the UTC fix were entered in this
# timezone; the 2026_09_22 data migration converts them once.
LEGACY_EVENT_TIMEZONE=Asia/Kolkata

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Public invitation/wishes responses are cached (App\Support\InvitationCache).
# Use redis in production; database works for local dev without a Redis server.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is pure PHP (composer dep) — no phpredis extension needed.
REDIS_CLIENT=predis
# Railway/managed Redis: set REDIS_URL instead of host/password/port.
# REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Uploaded invitation photos/audio. Leave UPLOADS_DISK unset for local dev
# (writes to the local 'public' disk, as before). In production (Railway),
# set UPLOADS_DISK=r2 plus the four R2_* values below — Railway's container
# disk does not survive a redeploy, so local storage alone loses every
# uploaded file each time the service redeploys. See CLAUDE.md.
UPLOADS_DISK=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

VITE_APP_NAME="${APP_NAME}"
